{
    "version": 2,
    "builds": [
      {
        "src": "proquest/package.json",
        "use": "@vercel/static-build",
        "config": { "distDir": "dist" }
      },
      {
        "src": "backend/api/index.js",
        "use": "@vercel/node"
      }
    ],
    "cleanUrls": true,
    "trailingSlash": false,
    "rewrites": [
      { "source": "/api/:path*", "destination": "/backend/api/index.js" },
      { "source": "/:path*", "destination": "/proquest/dist/index.html" }
    ]
  }
  