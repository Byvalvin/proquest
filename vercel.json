{
    "version": 2,
    "buildCommand": "npm run vercel-build",
    "outputDirectory": "proquest/dist",
    "routes": [
      {
        "src": "/api/(.*)",
        "dest": "backend/api/index.js"
      },
      {
        "src": "/(.*)",
        "dest": "/proquest/dist/index.html"
      }
    ]
  }
  