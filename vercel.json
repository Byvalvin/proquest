{
    "version": 2,
    "rewrites": [
      { "source": "/api/(.*)", "destination": "/api/$1" },
      { "source": "/(.*)", "destination": "/proquest/dist/index.html" }
    ],
    "builds": [
      {
        "src": "proquest/package.json",
        "use": "@vercel/static-build"
      },
      {
        "src": "backend/api/index.js",
        "use": "@vercel/node"
      }
    ],
    "routes": [
      {
        "src": "/api/(.*)",
        "dest": "backend/api/index.js"
      }
    ]
  }
  